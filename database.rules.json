{
  "rules": {
    ".read": false,
    ".write": false,
    "gms_state": {
      "v1": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.exists() && newData.hasChildren(['users','students','incidentReports','goodMoralRequests','archives','notifications','auditLogs','settings'])",
        ".indexOn": ["updatedAt"]
      }
    }
  }
}
